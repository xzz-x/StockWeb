# Tushare token: keep the real token only in .env / server secret storage.
TUSHARE_TOKEN=

# MySQL (prepared for persistence; v1 pages can query Tushare directly)
DATABASE_URL=mysql+pymysql://stockweb:change_me@127.0.0.1:3306/stockweb?charset=utf8mb4

# Comma-separated browser origins allowed to call FastAPI during development.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
